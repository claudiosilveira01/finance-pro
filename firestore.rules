rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /config/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /meses/{mesId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Qualquer caminho não listado acima é negado por padrão pelo Firestore.
  }
}
